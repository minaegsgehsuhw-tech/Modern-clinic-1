{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/doctor/patient/[id]",
      "regex": "^/doctor/patient/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/doctor/patient/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin/finance",
      "regex": "^/admin/finance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/finance(?:/)?$"
    },
    {
      "page": "/api/export-finance",
      "regex": "^/api/export\\-finance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/export\\-finance(?:/)?$"
    },
    {
      "page": "/api/tts",
      "regex": "^/api/tts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/tts(?:/)?$"
    },
    {
      "page": "/api/whatsapp/logout",
      "regex": "^/api/whatsapp/logout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/whatsapp/logout(?:/)?$"
    },
    {
      "page": "/api/whatsapp/status",
      "regex": "^/api/whatsapp/status(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/whatsapp/status(?:/)?$"
    },
    {
      "page": "/book",
      "regex": "^/book(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/book(?:/)?$"
    },
    {
      "page": "/doctor",
      "regex": "^/doctor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/doctor(?:/)?$"
    },
    {
      "page": "/doctor/finance",
      "regex": "^/doctor/finance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/doctor/finance(?:/)?$"
    },
    {
      "page": "/doctor/patients",
      "regex": "^/doctor/patients(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/doctor/patients(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/patient",
      "regex": "^/patient(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/patient(?:/)?$"
    },
    {
      "page": "/queue",
      "regex": "^/queue(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/queue(?:/)?$"
    },
    {
      "page": "/secretary",
      "regex": "^/secretary(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/secretary(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}