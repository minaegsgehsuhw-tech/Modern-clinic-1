generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id              Int        @id @default(autoincrement())
  name            String
  phone           String     @unique
  chronicDiseases String?
  allergies       String?
  tags            String?
  createdAt       DateTime   @default(now())
  age             Int?
  documents       Document[]
  visits          Visit[]
}

model Visit {
  id              Int            @id @default(autoincrement())
  queueNumber     Int
  appointmentDate DateTime?
  type            String
  status          String         @default("WAITING")
  diagnosis       String?
  createdAt       DateTime       @default(now())
  patientId       Int
  amountPaid      Float?         @default(0)
  paymentMethod   String?        @default("CASH")
  prescriptions   Prescription[]
  patient         Patient        @relation(fields: [patientId], references: [id])
}

model Prescription {
  id           Int      @id @default(autoincrement())
  medicineName String
  dose         String
  duration     String
  createdAt    DateTime @default(now())
  visitId      Int
  visit        Visit    @relation(fields: [visitId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  createdAt   DateTime @default(now())
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  phone String @unique
  role  String
  pin   String
}

model Document {
  id        Int      @id @default(autoincrement())
  url       String
  type      String
  notes     String?
  createdAt DateTime @default(now())
  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Medicine {
  id                Int     @id @default(autoincrement())
  tradeName         String  @unique
  activeIngredient  String?
  commonDose        String?
  contraindications String?
}

model ServiceFee {
  id    Int    @id @default(autoincrement())
  type  String @unique
  price Float
}


model DeviceAccess {
  id          Int      @id @default(autoincrement())
  fingerprint String   @unique
  visitCount  Int      @default(1)
  lastVisit   DateTime @default(now())
}
